      "Resource": "arn:aws:bedrock-mantle:ap-south-1:305740358559:project/proj_otq67vwlewxzfizztrje",
      "Condition": {
        "StringEquals": {
          "bedrock-mantle:Model": "qwen.qwen3-235b-a22b-2507-v1:0",
          "aws:RequestedRegion": "ap-south-1"
        },
