# AP Command Center - Frontend Environment Variables
# These variables are consumed by Vite during development (npm run dev)
# and bundled at build time (npm run build).
# Only public, non-secret client values should be prefixed with VITE_.
VITE_SUPABASE_URL=https://yourprojectref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder
