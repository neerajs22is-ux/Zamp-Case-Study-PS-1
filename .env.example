# ==============================================================================
# AP Command Center — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide verified operational values.
# NEVER commit .env files containing production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Environment
# ------------------------------------------------------------------------------
# Must be one of: production, staging, development, test
APP_ENV=development
APP_NAME="Autonomous AP Command Center"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars-long

# Canonical base URL of the application
BASE_URL=http://localhost:8000

# Timezone for financial operations display (e.g. Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL Connection Separation)
# ------------------------------------------------------------------------------
# 2.1 RUNTIME CONNECTION: Supabase Transaction Pooler (Port 6543)
# Format: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=30

# 2.2 MIGRATION CONNECTION: Direct PostgreSQL / Session Pooler (Port 5432)
# Used exclusively by Alembic for DDL migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# 2.3 BACKUP & RESTORE CONNECTION: Direct PostgreSQL (Port 5432)
BACKUP_DATABASE_URL=postgresql+psycopg://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Identity & Access Management (Supabase Auth)
# ------------------------------------------------------------------------------
IDP_PROVIDER=supabase_auth
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
SUPABASE_JWKS_URL=https://yourprojectref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://yourprojectref.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# Strictly false in production/staging. Bypasses IdP token verification in dev tests.
LOCAL_AUTH_BYPASS=false

# Development-only session generator endpoint flag (POST /api/v1/auth/dev-session).
# Strictly False in staging and production; restricted to loopback clients (127.0.0.1).
ENABLE_DEV_SESSION=false

# ------------------------------------------------------------------------------
# 4. Private Encrypted Object Storage (Supabase Storage Primary, S3 Supported)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=invoices
STORAGE_BUCKET_NAME=invoices
STORAGE_REGION=ap-south-1
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. AWS Bedrock Mantle Document Intelligence (Primary LLM Engine)
# ------------------------------------------------------------------------------
# Model: Qwen3-235B (qwen.qwen3-235b-a22b-2507-v1:0) in AWS ap-south-1 (Mumbai)
MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
MANTLE_API_KEY=your-mantle-api-key-placeholder
MANTLE_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
MANTLE_TIMEOUT_SECONDS=30.0
MANTLE_MAX_TOKENS=2048
MANTLE_TEMPERATURE=0.0
MANTLE_COST_PER_1K_INPUT=0.0006
MANTLE_COST_PER_1K_OUTPUT=0.0024
MANTLE_MAX_DOCUMENT_COST_USD=0.10
MANTLE_MONTHLY_BUDGET_USD=50.00

# ------------------------------------------------------------------------------
# 6. AWS Bedrock Palmyra Vision 7B (Multimodal Visual Adapter)
# ------------------------------------------------------------------------------
# Model: writer.palmyra-vision-7b in AWS us-east-1 (N. Virginia)
# Disabled by default; pilot feature evaluated for degraded scans with fail-closed HITL fallback.
ENABLE_PALMYRA_VISION=false
PALMYRA_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
PALMYRA_API_KEY=your-palmyra-api-key-placeholder
PALMYRA_MODEL_ID=writer.palmyra-vision-7b

# ------------------------------------------------------------------------------
# 7. Customer Financial Policy & Tolerances
# ------------------------------------------------------------------------------
# Dual-control approval threshold in INR (requires secondary Controller sign-off)
DUAL_APPROVAL_THRESHOLD_INR=500000.00
# Tolerance for line-item unit rate variance (percentage e.g. 1.5)
RATE_TOLERANCE_PERCENT=1.50
# Tolerance for tax and freight rounding in INR (e.g. 20.00)
ROUNDING_TOLERANCE_INR=20.00

# ------------------------------------------------------------------------------
# 8. Document Retention & Purge Compliance Policy
# ------------------------------------------------------------------------------
DOCUMENT_RETENTION_DAYS=2920
ENABLE_PERMANENT_PURGE=false

# ------------------------------------------------------------------------------
# 9. Backup & Disaster Recovery (AES-256 GCM)
# ------------------------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-placeholder
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=10

# ------------------------------------------------------------------------------
# 10. Gmail Ingestion (Phase B OAuth 2.0 with Incremental History API)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-google-oauth-client-id-placeholder
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret-placeholder
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/connections/gmail/callback
GMAIL_ENCRYPTION_KEY=your-32-byte-hex-token-encryption-key-placeholder
PUBSUB_TOPIC_NAME=projects/your-gcp-project/topics/gmail-notifications
PUBSUB_VERIFICATION_AUDIENCE=https://your-domain.com/api/v1/webhooks/gmail/pubsub
PUBSUB_SERVICE_ACCOUNT_EMAIL=gmail-pubsub-push@your-gcp-project.iam.gserviceaccount.com
PUBSUB_ACK_DEADLINE_SECONDS=300
GMAIL_SYNC_TIMEOUT_SECONDS=240
GMAIL_WATCH_RENEWAL_HOURS=48
GMAIL_RECONCILIATION_HOURS=6

# ------------------------------------------------------------------------------
# 11. SAP S/4HANA ERP Adapter (Phase B OData API)
# ------------------------------------------------------------------------------
SAP_API_BASE_URL=https://your-sap-instance.corp:443/sap/opu/odata/sap/
SAP_AUTH_TYPE=oauth2
SAP_CLIENT_ID=your-sap-client-id-placeholder
SAP_CLIENT_SECRET=your-sap-client-secret-placeholder
SAP_TOKEN_URL=https://your-sap-instance.corp/oauth/token
SAP_COMPANY_CODE=1000
SAP_ERP_CACHE_TTL_MINUTES=60
