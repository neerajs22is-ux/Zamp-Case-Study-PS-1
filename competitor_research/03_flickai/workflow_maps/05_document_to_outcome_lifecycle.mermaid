flowchart LR
    subgraph S1["1. Intake & Repository"]
        A1["/files"]
        A2["Purchase Invoices (AP)"]
        A3["Sales Invoices (AR)"]
        A4["Bank Statements"]
        A5["Payment Aggregators"]
    end

    subgraph S2["2. Document Processing"]
        B1["/invoices"]
        B2["Invoice Builder & Review"]
        B3["Line Items & HSN Matrix"]
        B4["GST Calculation Engine"]
    end

    subgraph S3["3. General Ledger"]
        C1["/ledgers"]
        C2["Party-Wise Ledgers"]
        C3["Journal Entries"]
        C4["Opening Balances"]
        C5["Zoho Books Sync"]
    end

    subgraph S4["4. Reconciliation & Tax"]
        D1["Bank Matching"]
        D2["Gateway Settlement"]
        D3["GST Compliance Engine"]
        D4["TDS Compliance Engine"]
    end

    subgraph S5["5. Financial Outcomes"]
        E1["/dashboard"]
        E2["Profit & Loss Statement"]
        E3["Balance Sheet"]
        E4["Excel Financial Export"]
    end

    A1 --> A2 & A3 & A4 & A5
    A2 & A3 --> B1 --> B2 --> B3 --> B4
    B4 --> C1 --> C2 & C3 & C4 & C5
    A4 & A5 --> D1 & D2
    D1 & D2 --> C1
    C1 --> D3 & D4
    C1 --> E1
    C1 --> E2 & E3 --> E4
