flowchart TD
    subgraph StreamA["Bank Statement Stream"]
        A1["Bank Statement Upload (CSV/PDF)"]
        A2["Parser Extracts: Date | Description/Narration | Reference No | Debit | Credit | Balance"]
    end

    subgraph StreamB["Payment Gateway Stream"]
        B1["Razorpay / Payment Aggregator Upload (CSV)"]
        B2["Parser Extracts: Transaction ID | Order ID | Fee | Tax | Settlement Net"]
    end

    subgraph StreamC["Internal Accounting Records"]
        C1["Purchase Invoices (AP Bills)"]
        C2["Sales Invoices (AR Invoices)"]
        C3["Manual Journal Entries & Opening Balances"]
    end

    subgraph MatchingEngine["Reconciliation & Auto-Match Engine"]
        M1["Exact Match Logic (Reference ID + Exact Amount + Date +/- 3 Days)"]
        M2{"Match Confidence Score"}
        M3["Status: Matched (Auto-linked)"]
        M4["Status: Unmatched (Flagged for Review)"]
    end

    subgraph HumanResolution["Human-in-the-Loop Reconciliation"]
        H1["Reviewer Inspects Unmatched Records"]
        H2["Options: Split Payment | Adjust Bank Fee / TDS | Manual Link to Invoice | Create Unlinked Entry"]
        H3["Reviewer Confirms Reconciliation Link"]
    end

    subgraph LedgerPosting["General Ledger & Reporting Sync"]
        L1["Bank Account Ledger Updated (/ledgers)"]
        L2["Customer/Vendor Party Ledger Reconciled"]
        L3["Financial Statements Updated (Cash Flow & Balance Sheet)"]
    end

    A1 --> A2 --> M1
    B1 --> B2 --> M1
    C1 --> M1
    C2 --> M1
    C3 --> M1
    M1 --> M2
    M2 -- High Confidence / Exact --> M3
    M2 -- Discrepancy / No Match --> M4
    M4 --> H1
    H1 --> H2
    H2 --> H3
    M3 --> L1
    H3 --> L1
    L1 --> L2
    L2 --> L3
