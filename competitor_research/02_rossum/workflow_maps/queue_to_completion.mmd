flowchart LR
    %% Rossum Queue to Completion Journey
    subgraph QUEUE_VIEW ["1. Queue Management & Prioritization"]
        Q1[Queue Selection: e.g. Tax invoices US] --> Q2[Inspect Count Badge: e.g. 5 Docs]
        Q2 --> Q3[Filter by 'To review' or custom attributes]
        Q3 --> Q4[Select First Document]
    end

    subgraph WORKSPACE ["2. Document Review & Validation"]
        Q4 --> W1[Instant Split-Pane Load]
        W1 --> W2[Scan Header Fields & Totals]
        W2 --> W3[Expand & Verify Line Items Table]
        W3 --> W4{Validation Status}
        W4 -- "Error Present" --> W5[Correct via editBoxInput or Canvas Click]
        W4 -- "Valid" --> W6[Keyboard Shortcut Confirm]
        W5 --> W6
    end

    subgraph TRANSITION ["3. Transition & Continuous Processing"]
        W6 --> T1[Micro-Survey Feedback Prompt]
        T1 --> T2{Queue Empty?}
        T2 -- "No (More docs remain)" --> W1
        T2 -- "Yes (Queue cleared)" --> Q1
    end
