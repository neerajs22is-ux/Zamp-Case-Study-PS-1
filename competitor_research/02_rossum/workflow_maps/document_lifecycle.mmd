flowchart TD
    %% Rossum Complete Document Lifecycle
    subgraph INTAKE ["1. Intake & Multi-Channel Ingestion"]
        A1[Manual File Upload / Drag & Drop] --> B[Rossum Ingestion Pipeline]
        A2[Dedicated Email Inbox Address] --> B
        A3[REST API / External Connector SAP, Coupa] --> B
    end

    subgraph PREPROCESSING ["2. Ingestion & Pre-processing"]
        B --> C1[Document Splitting & Rotation]
        C1 --> C2[OCR & Text Layer Extraction]
        C2 --> C3[Document Classification & Queue Routing]
    end

    subgraph AI_EXTRACTION ["3. AI Extraction & Validation Engine"]
        C3 --> D1[Queue Schema Evaluation]
        D1 --> D2[Header Fields Extraction: Vendor, ID, Dates, Amounts]
        D1 --> D3[Line Items Table Extraction: Items, Qty, Rates, Tax]
        D2 --> D4{Validation Rules & Confidence Checks}
        D3 --> D4
    end

    subgraph ROUTING ["4. Confidence-Based Decision Point"]
        D4 -- "All Required Fields Valid & High Confidence" --> E1[Straight-Through Processing / Auto-Confirm]
        D4 -- "Missing Fields, Low Confidence, or Rule Errors" --> E2[Queue: 'To review' / Assigned to Human Operator]
    end

    subgraph HUMAN_REVIEW ["5. Human-in-the-Loop Review Workspace"]
        E2 --> F1[Operator Opens Document Review Workspace]
        F1 --> F2[Split View: PDF Viewer vs Extracted Data Panel]
        F2 --> F3{Operator Decision}
        F3 -- "Accept All Fields" --> G1[Confirm]
        F3 -- "Field Correction Needed" --> G2[Inline Edit via editBoxInput or Canvas Point-and-Click]
        F3 -- "Unresolvable Exception" --> G3[Postpone / Reject / Move to Another Queue]
        G2 --> G1
    end

    subgraph EXPORT ["6. Downstream Export & Master Data Hub"]
        E1 --> H[Export Pipeline: Webhook, ERP SAP, Coupa, CSV/JSON]
        G1 --> H
        G3 --> I[Exception Queue / Supplier Query Resolution]
    end
