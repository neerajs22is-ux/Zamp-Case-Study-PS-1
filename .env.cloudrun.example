# =============================================================================
# Autonomous AP Command Center — Cloud Run Environment Contract
# =============================================================================
# This template documents all required and optional environment variables
# for running the AP Command Center container on Google Cloud Run (Mumbai asia-south1).
#
# SECURITY DIRECTIVE:
#   NEVER commit production secrets to Git.
#   In Cloud Run, all sensitive values MUST be provisioned in Google Secret Manager
#   and mounted as environment variables using secretKeyRef in service.yaml.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=Autonomous AP Command Center
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=false
LOCAL_AUTH_BYPASS=false
APP_TIMEZONE=Asia/Kolkata
# The canonical HTTPS public URL allocated to your Cloud Run service
BASE_URL=https://ap-command-center-<project-hash>-el.a.run.app

# SECRET MANAGER: ap-secret-key
# Cryptographically random 32+ character key for session cookie signing and token hashing
SECRET_KEY=change-this-in-secret-manager-to-32-chars-minimum

# -----------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE & CONNECTION SEPARATION
# -----------------------------------------------------------------------------
# SECRET MANAGER: ap-database-url
# 2.1 RUNTIME CONNECTION: Supabase Transaction Pooler (port 6543)
# Recommended for serverless scale-to-zero Cloud Run workloads.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourdbpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_TIMEOUT_SECONDS=30

# 2.2 MIGRATION CONNECTION: Direct PostgreSQL or Session Pooler (port 5432)
# Used exclusively by Alembic for DDL migrations. Transaction pooler (port 6543) MUST NOT be used for migrations.
# Direct format: postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres.yourprojectref:yourdbpassword@db.yourprojectref.supabase.co:5432/postgres?sslmode=require

# 2.3 BACKUP & RESTORE CONNECTION: Direct PostgreSQL or Session Pooler (port 5432)
# Used exclusively by operator CLI backup/restore scripts for schema inspection and streaming copy.
BACKUP_DATABASE_URL=postgresql://postgres.yourprojectref:yourdbpassword@db.yourprojectref.supabase.co:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# 3. SUPABASE AUTH & IDENTITY PROVIDER
# -----------------------------------------------------------------------------
IDP_PROVIDER=supabase_auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project-id.supabase.co/auth/v1

# Public publishable anon key (does not require Secret Manager encapsulation)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SECRET MANAGER: ap-supabase-service-key
# Server-side service key for Supabase Storage administration.
# Format: Legacy JWT (eyJ...) or modern Supabase secret key (sb_secret_...).
# Adapter uses format-aware headers ('apikey' header only for sb_secret_; apikey + Bearer for legacy JWT).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# SECRET MANAGER: ap-supabase-jwt-secret
# Required ONLY if Supabase project uses legacy HS256 symmetric signing.
# Optional when project uses modern asymmetric RS256/ES256 JWKS signing.
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret-if-using-hs256

# -----------------------------------------------------------------------------
# 4. SUPABASE STORAGE (Zero-AWS Ingestion)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=invoices
STORAGE_BUCKET_NAME=invoices
STORAGE_REGION=ap-south-1
STORAGE_SIGNED_URL_EXPIRY_SECONDS=300
MAX_UPLOAD_FILE_SIZE_BYTES=52428800  # 50 MB (Supabase Free tier limit)

# -----------------------------------------------------------------------------
# 5. GMAIL API & GOOGLE CLOUD PUB/SUB INGESTION
# -----------------------------------------------------------------------------
# Public client OAuth identifier (env var, not a secret)
# Note: Google OAuth consent screen & client must request strictly and exclusively:
#   https://www.googleapis.com/auth/gmail.readonly (least-privilege; gmail.modify is barred)
# TESTING LIMITATION NOTICE:
#   In Google OAuth "Testing" status, refresh tokens expire after 7 days for external users.
#   Do not claim uninterrupted automated ingestion until the app is set to "Internal" in Google Workspace
#   or completes Google OAuth App Verification and CASA Tier 2 Restricted Scope Assessment.
#   Reconnect expired mailboxes via GET /api/v1/integrations/gmail/authorize.
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

GMAIL_TARGET_MAILBOX=ap.invoices@yourcompany.com
PUBSUB_TOPIC_NAME=projects/your-gcp-project/topics/gmail-ap-inbox
PUBSUB_SERVICE_ACCOUNT_EMAIL=gmail-pubsub-push@your-gcp-project.iam.gserviceaccount.com
PUBSUB_VERIFICATION_AUDIENCE=https://ap-command-center-<project-hash>-el.a.run.app/api/v1/integrations/gmail/pubsub/push
PUBSUB_ACK_DEADLINE_SECONDS=300

# Internal Gmail sync deadline (240s) comfortably below 300s Cloud Run & Pub/Sub timeout
GMAIL_SYNC_TIMEOUT_SECONDS=240

GMAIL_WATCH_RENEWAL_HOURS=48
GMAIL_RECONCILIATION_HOURS=6

# -----------------------------------------------------------------------------
# 5.1 CLOUD SCHEDULER MAINTENANCE AUTHENTICATION (Stage 7.1)
# -----------------------------------------------------------------------------
# Dedicated service account identity strictly used by Cloud Scheduler
CLOUD_SCHEDULER_SERVICE_ACCOUNT_EMAIL=ap-cloud-scheduler-sa@your-gcp-project.iam.gserviceaccount.com
CLOUD_SCHEDULER_VERIFICATION_AUDIENCE=https://ap-command-center-<project-hash>-el.a.run.app

# SECRET MANAGER: ap-gmail-client-secret
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# Note: GMAIL_REFRESH_TOKEN is NOT a production Cloud Run secret.
# Refresh tokens are managed per mailbox and stored encrypted in PostgreSQL (gmail_accounts.encrypted_refresh_token).
# Optional for local test/dev only:
# GMAIL_REFRESH_TOKEN=1//0your-oauth-refresh-token-for-ap-mailbox

# SECRET MANAGER: ap-gmail-encryption-key
# 32-byte urlsafe base64 Fernet key for encrypting OAuth tokens in PostgreSQL
GMAIL_ENCRYPTION_KEY=generate-with-Fernet.generate_key()

# -----------------------------------------------------------------------------
# 6. OPERATOR BACKUP & RECOVERY ENCRYPTION (Local CLI Only)
# -----------------------------------------------------------------------------
# Note: Container filesystem is ephemeral. Automated backups are NOT scheduled in Cloud Run.
# Backups are executed by operators via CLI on trusted local workstations and copied to offline storage.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=10

# Note: BACKUP_ENCRYPTION_KEY is NOT a Cloud Run container secret.
# It is managed exclusively by the operator on trusted workstations for encrypting backup archives.
# Optional operator workstation environment variable:
# BACKUP_ENCRYPTION_KEY=generate-with-python--m-backend.scripts.backup---generate-key

# -----------------------------------------------------------------------------
# 7. FINANCIAL POLICY THRESHOLDS & STATUTORY COMPLIANCE
# -----------------------------------------------------------------------------
DUAL_APPROVAL_THRESHOLD_INR=500000.00
RATE_TOLERANCE_PERCENT=1.50
ROUNDING_TOLERANCE_INR=20.00
DOCUMENT_RETENTION_DAYS=2920  # 8 years statutory financial record retention
ENABLE_PERMANENT_PURGE=false   # Disabled until dual-approval governance is certified
